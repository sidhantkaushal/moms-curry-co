# Public (safe for browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Or legacy JWT: NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only — never commit real values
# API settings → Secret key (sb_secret_...) or legacy service_role JWT
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
# Min 16 chars; used to hash private order tracking tokens
ORDER_TOKEN_PEPPER=replace-with-long-random-string

# Optional contact overrides (otherwise use business_settings in Supabase / admin UI)
# NEXT_PUBLIC_WHATSAPP_PHONE=8076577033
# NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/918076577033
# NEXT_PUBLIC_WHATSAPP_PREFILL_MESSAGE=Hi! I have a question about today's menu.

# Optional future integrations (not required for v1 POD orders)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
